# PostgreSQL
POSTGRES_DB=sifap
POSTGRES_USER=sifap
POSTGRES_PASSWORD=sifap_local
# Porta publicada no host. Altere se a 5432 já estiver ocupada localmente.
POSTGRES_HOST_PORT=5432

# Backend
# Porta publicada no host. Altere se a 8080 já estiver ocupada localmente.
BACKEND_HOST_PORT=8080
SIFAP_JWT_SECRET=local-dev-secret-min-32-chars-long!!

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
